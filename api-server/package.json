{
  "name": "krypto-chat-api-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx --env-file=.env scripts/migrate.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:messages": "tsx --env-file=.env scripts/seed-messages.ts"
  },
  "dependencies": {
    "@fastify/websocket": "^11.3.1",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "embedded-postgres": "17.9.0-beta.17",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
